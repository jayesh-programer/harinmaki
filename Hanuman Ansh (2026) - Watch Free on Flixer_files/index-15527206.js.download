        @keyframes batFly {
          0% { 
            opacity: 0; 
            transform: translateX(-50px) translateY(20px) rotate(-45deg) scale(0.5);
          }
          20% { 
            opacity: 0.8; 
            transform: translateX(-20px) translateY(10px) rotate(-45deg) scale(0.8);
          }
          50% { 
            opacity: 1; 
            transform: translateX(20px) translateY(-10px) rotate(-45deg) scale(1);
          }
          80% { 
            opacity: 0.6; 
            transform: translateX(50px) translateY(-20px) rotate(-45deg) scale(0.8);
          }
          100% { 
            opacity: 0; 
            transform: translateX(80px) translateY(-30px) rotate(-45deg) scale(0.5);
          }
        }
        @keyframes spookyGlow {
          0%, 100% { 
            filter: drop-shadow(0 0 60px rgba(229, 9, 20, 0.6)) drop-shadow(0 0 20px rgba(139, 69, 19, 0.4)) drop-shadow(0 0 40px rgba(178, 7, 16, 0.3));
          }
          50% { 
            filter: drop-shadow(0 0 80px rgba(229, 9, 20, 0.8)) drop-shadow(0 0 30px rgba(139, 69, 19, 0.6)) drop-shadow(0 0 60px rgba(178, 7, 16, 0.5));
          }
        }
        @keyframes spookyPulse {
          0%, 100% { 
            opacity: 0.3;
            transform: scale(1);
          }
          50% { 
            opacity: 0.8;
            transform: scale(1.1);
          }
        }
        .bat-shape {
          position: relative;
          width: 20px;
          height: 12px;
        }
        .bat-shape::before {
          content: '';
          position: absolute;
          top: 0;
          left: 50%;
          transform: translateX(-50%);
          width: 8px;
          height: 8px;
          background: #1a0a0a;
          border-radius: 50%;
        }
        .bat-shape::after {
          content: '';
          position: absolute;
          top: 2px;
          left: 0;
          width: 20px;
          height: 8px;
          background: #1a0a0a;
          clip-path: polygon(20% 0%, 0% 100%, 40% 50%, 60% 50%, 100% 100%, 80% 0%);
        }
      `}),e,C.jsxs("div",{ref:n,className:"fixed inset-0 z-[100] overflow-hidden pointer-events-none",children:[C.jsx("div",{ref:s,className:"absolute inset-0 opacity-0",style:{background:"linear-gradient(135deg, #000000 0%, #1a0a0a 15%, #2d0a0a 25%, #1a0a0a 40%, #0a0a0a 60%, #000000 100%)",animation:"spookyPulse 3s ease-in-out infinite"}}),C.jsx("div",{ref:i,className:"absolute inset-0 opacity-0",style:{background:"radial-gradient(ellipse at center, rgba(229, 9, 20, 0.15) 0%, rgba(178, 7, 16, 0.08) 30%, rgba(139, 69, 19, 0.05) 50%, rgba(0, 0, 0, 0.8) 80%)"}}),C.jsx("div",{ref:o,className:"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] opacity-0",style:{background:"radial-gradient(circle at center, rgba(229, 9, 20, 0.4) 0%, rgba(178, 7, 16, 0.2) 25%, rgba(139, 69, 19, 0.1) 50%, rgba(0, 0, 0, 0) 70%)",filter:"blur(80px)",animation:"spookyPulse 2.5s ease-in-out infinite"}}),C.jsx("div",{className:"absolute inset-0 overflow-hidden",children:[...Array(8)].map((g,m)=>C.jsx("div",{className:"absolute w-1 h-1 bg-red-500/30 rounded-full",style:{left:`${Math.random()*100}%`,top:`${Math.random()*100}%`,animation:`spookyPulse ${2+Math.random()*3}s ease-in-out infinite ${Math.random()*2}s`}},m))}),C.jsx("div",{className:"absolute inset-0 flex items-center justify-center",children:C.jsxs("div",{className:"flex flex-col items-center",children:[C.jsxs("div",{className:"relative",children:[C.jsx("img",{ref:r,src:nS(),alt:Li(),className:"w-56 h-56 sm:w-64 sm:h-64 md:w-72 md:h-72 lg:w-80 lg:h-80 xl:w-88 xl:h-88 object-contain",style:{filter:"drop-shadow(0 0 60px rgba(229, 9, 20, 0.6)) drop-shadow(0 30px 60px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 120px rgba(229, 9, 20, 0.3)) drop-shadow(0 0 20px rgba(139, 69, 19, 0.4))",animation:"spookyGlow 2s ease-in-out infinite"}}),C.jsx("div",{className:"absolute -top-12 -left-12 bat-shape",style:{animation:"batFly 4s ease-in-out infinite"}}),C.jsx("div",{className:"absolute -top-8 -right-8 bat-shape",style:{anima